# Copia este archivo a .env y ajusta los valores. Sin .env el servidor usa los de desarrollo de
# app/settings.py (PostgreSQL local, base «template»), pero solo con DEBUG=true: con DEBUG=false
# exige tu propia DATABASE_URL y SECRET_KEY.

# true: documentación en /docs, errores con detalle técnico y cookies sin HTTPS.
# false (producción): sin documentación, cookies solo por HTTPS y JWT_ISSUER con https://.
DEBUG=true

# Nombre del proyecto: sale en la documentación y da nombre a las cookies de sesión
# (<nombre>_access y <nombre>_refresh). Cámbialo en cada proyecto; al cambiarlo se cierran las sesiones.
APP_NAME=Template
APP_VERSION=0.1.0

# PostgreSQL. Si la clave tiene caracteres especiales (@ / : #), codifícalos: @ es %40.
DATABASE_URL=postgres://usuario:clave@localhost:5432/template

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Mínimo 32 caracteres. Generar una: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# URL pública de la API, con https:// en producción (https://api.midominio.com).
JWT_ISSUER=http://localhost:8000
